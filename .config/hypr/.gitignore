# Custom configuration overrides
configs/custom/*
!configs/custom/.gitkeep
!configs/custom/claude-keybinds.conf

# Auto-generated monitor configuration (hardware-specific)
configs/monitors.conf

# Theme configuration
theme/theme.conf

# Hyprpaper configuration
hyprpaper/config/*
!hyprpaper/config/defaults.conf

# Backup files
*.backup.*
*.bak
*~
*.backup

# Experimental/development scripts
scripts/*-fixed.sh
scripts/*-bridge.sh
scripts/*-handler.sh
scripts/claude-code-*.sh
scripts/claude-direct-*.sh
scripts/claude-smart-*.sh

# Claude Code local configuration
.claude/settings.local.json

# Temporary clipboard files
/tmp/claude-clipboard/
