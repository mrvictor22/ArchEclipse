# ===========================================
# ArchEclipse .gitignore
# ===========================================
# Strategy: Ignore EVERYTHING by default, then whitelist specific files.
# This prevents personal files from being tracked accidentally.
# ===========================================

# Ignore all files by default
/*

!LICENSE

!.gitignore
!README.md

!.github

!.config/
.config/*

# Include hyprland config
!.config/hypr/
# Include kitty config (disabled - now using foot)
# !.config/kitty/
# include foot config
!.config/foot/
# include ranger config
!.config/ranger/
# include btop config
!.config/btop/
# include aria2c config
!.config/aria2/
# include pipwire config
!.config/pipewire/
# include ags
!.config/ags/
# include wayvnc config
!.config/wayvnc/
# include fastfetch config
!.config/fastfetch/
# wallpapers
!.config/wallpapers/
# Ignore discretion/SFW wallpapers (personal collection from Wallhaven API)
.config/wallpapers/discretion/
# include starship config
!.config/starship.toml

# include icons (cursort theme)
!.icons/

# include zsh config
!.zshrc
